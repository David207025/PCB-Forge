FROM rust:latest

# Install system dependencies required for WebKit/GTK bindings and toolchain un-archiving
RUN apt-get update && apt-get install -y \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    pkg-config \
    build-essential \
    libssl-dev \
    xz-utils

# Pre-install the Linux targets so rustc has the 'core' library available
RUN rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu

WORKDIR /app