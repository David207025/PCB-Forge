FROM rust:latest

# Enable multiarch for x86_64 cross-compilation
RUN dpkg --add-architecture amd64

# Update and install build dependencies + cross-compiler + target libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    xz-utils \
    gcc-x86-64-linux-gnu \
    libgtk-3-dev:amd64 \
    libwebkit2gtk-4.1-dev:amd64 \
    libxdo-dev:amd64

# Pre-install Rust target architectures
RUN rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu

WORKDIR /app