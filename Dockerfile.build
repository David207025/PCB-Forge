FROM rust:latest

# Install all required system libraries for GTK, WebKit, X11, and xdotool bindings
RUN apt-get update && apt-get install -y \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libxdo-dev \
    pkg-config \
    build-essential \
    libssl-dev \
    xz-utils \
    gcc-x86-64-linux-gnu

# Pre-install target architectures
RUN rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu

WORKDIR /app