{
  "publisher": "vacaroiudavid",
  "name": "pcb-forge",
  "displayName": "PCB Forge",
  "description": "Next-gen PCB design tool for VS Code",
  "version": "0.3.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/David207025/PCB-Forge.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.89.0"
  },
  "activationEvents": [
    "onCommand:pcb-forge.openEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pcb-forge-container",
          "title": "PCB Forge",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "pcb-forge-container": [
        {
          "id": "pcbForgeControlPanel",
          "name": "Control Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "pcb-forge.openDashboard",
        "title": "Open Web Dashboard",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pcb-forge.openDashboard",
          "when": "view == pcbForgeControlPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.89.0",
    "typescript": "^5.5.3"
  }
}
