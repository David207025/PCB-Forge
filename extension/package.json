{
  "publisher": "vacaroiudavid",
  "name": "pcb-forge",
  "displayName": "PCB Forge",
  "description": "Next-gen PCB design tool for VS Code",
  "version": "0.3.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/David207025/PCB-Forge.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.89.0"
  },
  "activationEvents": ["onCommand:pcb-forge.openEditor"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pcbForgeActivityBar",
          "title": "PCB Forge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pcbForgeActivityBar": [
        {
          "type": "webview",
          "id": "pcbForgeSidebarView",
          "name": "PCB Forge"
        }
      ]
    },
    "commands": [
      {
        "command": "pcb-forge.openDashboard",
        "title": "PCB Forge: Open Dashboard"
      },
      {
        "command": "pcb-forge.createTemplate",
        "title": "PCB Forge: Create Template"
      },
      {
        "command": "pcb-forge.createProject",
        "title": "PCB Forge: Create Project"
      },
      {
        "command": "pcb-forge.generateTemplates",
        "title": "PCB Forge: Generate Templates"
      },
      {
        "command": "pcb-forge.generateProject",
        "title": "PCB Forge: Generate Project"
      },
      {
        "command": "pcb-forge.startDaemon",
        "title": "PCB Forge: Start Background Service"
      },
      {
        "command": "pcb-forge.stopDaemon",
        "title": "PCB Forge: Stop Background Service"
      },
      {
        "command": "pcb-forge.restartDaemon",
        "title": "PCB Forge: Restart Background Service"
      },
      {
        "command": "pcb-forge.checkAccess",
        "title": "PCB Forge: Check KiCad Access & Permissions"
      },
      {
        "command": "pcb-forge.installDaemon",
        "title": "PCB Forge: Register Background Service (Boot Autostart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pcb-forge.openDashboard",
          "when": "view == pcbForgeControlPanel",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "pcbf",
        "aliases": ["PCB Forge Project", "pcbf"],
        "extensions": [".pcbf"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "pcbf",
        "scopeName": "source.pcbf",
        "path": "./syntaxes/pcbf.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p .",
    "build:webview": "node build-webview.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
