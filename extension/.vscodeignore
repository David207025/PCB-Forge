# ── Source & compiled extension output ───────────────────────────────────────
# TypeScript source — compiled to out/ by tsc; not needed in the VSIX
src/
tsconfig.json

# ── Web UI source tree ────────────────────────────────────────────────────────
# The entire web-ui/ directory is excluded from the VSIX.
# The compiled output is copied into extension/dist/ by build-webview.js, and
# that dist/ directory IS included in the package (it is not listed here).
web-ui/

# ── Build tooling ─────────────────────────────────────────────────────────────
# The build script itself only needs to run at packaging time, not at runtime
build-webview.js

# ── General ignores ───────────────────────────────────────────────────────────
.git*
.vscode*